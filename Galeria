.filters button{border:1px solid rgba(37,37,31,.2);background:transparent;padding:10px 16px;border-radius:999px;font:inherit;cursor:pointer}
.filters button.active{background:var(--dark);color:var(--paper);border-color:var(--dark)}
.grid{max-width:1280px;margin:0 auto;padding:22px 24px 72px;display:grid;grid-template-columns:repeat(12,1fr);grid-auto-flow:dense;gap:18px}
.photo{position:relative;border:0;padding:0;background:#ddd;overflow:hidden;border-radius:22px;cursor:zoom-in;min-height:310px;box-shadow:0 14px 38px rgba(33,28,20,.10)}
.photo.wide{grid-column:span 8}
.photo.tall{grid-column:span 4}
.photo img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.photo:hover img{transform:scale(1.025)}
.photo::after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.6));pointer-events:none}
.photo-label{position:absolute;z-index:2;left:20px;bottom:18px;color:white;font-family:Georgia,serif;font-size:24px;text-shadow:0 2px 10px rgba(0,0,0,.45)}
