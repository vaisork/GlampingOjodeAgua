.close p{color:#c8c3b9;max-width:620px;margin:0 auto 24px}
.buttons{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn{text-decoration:none;padding:14px 20px;border-radius:999px;font-weight:700}
.btn.primary{background:var(--amber);color:#171714}
.btn.secondary{border:1px solid rgba(255,255,255,.3);color:white}
footer{background:#090a08;color:white;padding:32px 5%}
.social{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.social-links{display:flex;gap:14px}
.social-links a{text-decoration:none;color:#bbb}
.version{margin-top:22px;font-size:10px;letter-spacing:.14em;color:rgba(255,255,255,.34)}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:99;display:none;align-items:center;justify-content:center;padding:20px}
.lightbox.open{display:flex}
.lightbox img{max-width:96vw;max-height:88vh;object-fit:contain;border-radius:12px}
.lightbox button{position:absolute;top:18px;right:18px;width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.35);color:white;font-size:25px;cursor:pointer}
@media(max-width:800px){
 .top{padding:15px 18px} .nav a:not(.cta){display:none}
 .hero{padding:52px 18px 24px} .hero p{font-size:16px}
